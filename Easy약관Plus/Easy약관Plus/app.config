<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System">
      <section name="DevExpress.LookAndFeel.Design.AppSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <applicationSettings>
    <DevExpress.LookAndFeel.Design.AppSettings>
      <setting name="DefaultAppSkin" serializeAs="String">
        <value>Skin/Office 2019 Dark Gray</value>
      </setting>
      <setting name="DefaultPalette" serializeAs="String">
        <value>Custom/Custom Palette #1</value>
      </setting>
      <setting name="TouchUI" serializeAs="String">
        <value></value>
      </setting>
      <setting name="CompactUI" serializeAs="String">
        <value></value>
      </setting>
      <setting name="TouchScaleFactor" serializeAs="String">
        <value></value>
      </setting>
      <setting name="DirectX" serializeAs="String">
        <value></value>
      </setting>
      <setting name="RegisterUserSkins" serializeAs="String">
        <value></value>
      </setting>
      <setting name="RegisterBonusSkins" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FontBehavior" serializeAs="String">
        <value></value>
      </setting>
      <setting name="DefaultAppFont" serializeAs="String">
        <value>카이겐고딕 KR Regular;9</value>
      </setting>
      <setting name="DPIAwarenessMode" serializeAs="String">
        <value></value>
      </setting>
      <setting name="CustomPaletteCollection" serializeAs="Xml">
        <value>
          <CustomPaletteCollection>
            <Skin Name="Office 2019 Dark Gray">
              <SvgPalette Name="Custom Palette #1">
                <SvgColor Name="Paint" Value="96,94,92" />
                <SvgColor Name="Paint High" Value="212,212,212" />
                <SvgColor Name="Paint Shadow" Value="190,187,184" />
                <SvgColor Name="Paint Deep Shadow" Value="68,68,68" />
                <SvgColor Name="Paint Dark" Value="38,38,38" />
                <SvgColor Name="Brush" Value="240,240,240" />
                <SvgColor Name="Brush High" Value="38,38,38" />
                <SvgColor Name="Brush Shadow" Value="38,38,38" />
                <SvgColor Name="Brush Light" Value="152,150,148" />
                <SvgColor Name="Brush Major" Value="68,68,68" />
                <SvgColor Name="Brush Minor" Value="68,68,68" />
                <SvgColor Name="Accent Paint" Value="0,120,212" />
                <SvgColor Name="Accent Paint Dark" Value="16,110,190" />
                <SvgColor Name="Accent Paint Light" Value="68,68,68" />
                <SvgColor Name="Accent Paint Lighter" Value="150,150,150" />
                <SvgColor Name="Alternate Accent Paint Light" Value="179,211,236" />
                <SvgColor Name="Alternate Accent Paint Lighter" Value="212,231,243" />
                <SvgColor Name="Accent Brush" Value="255,255,255" />
                <SvgColor Name="Accent Brush Light" Value="88,184,254" />
                <SvgColor Name="Red" Value="216,59,1" />
                <SvgColor Name="Green" Value="44,151,83" />
                <SvgColor Name="Blue" Value="45,80,156" />
                <SvgColor Name="Yellow" Value="217,120,57" />
                <SvgColor Name="Black" Value="68,68,68" />
                <SvgColor Name="Gray" Value="152,150,148" />
                <SvgColor Name="White" Value="248,248,248" />
                <SvgColor Name="Red Light" Value="252,117,83" />
                <SvgColor Name="Green Light" Value="115,221,131" />
                <SvgColor Name="Blue Light" Value="131,190,236" />
                <SvgColor Name="Yellow Light" Value="245,196,113" />
                <SvgColor Name="Black Light" Value="212,212,212" />
                <SvgColor Name="Gray Light" Value="152,150,148" />
                <SvgColor Name="White Light" Value="96,94,92" />
